# ==========================================
# enPromote Docker 专用环境变量模板
# 使用方法: 复制为 .env 或 docker/.env.docker
# cp docker/env.docker.example .env
# ==========================================

# ------------------------------------------
# 端口映射配置 (宿主机对外暴露的端口)
# ------------------------------------------
FRONTEND_PORT=80
SERVER_PORT=3000
MONGODB_PORT=27017
REDIS_PORT=6379

# ------------------------------------------
# 基础服务与数据库配置 (Docker 内部网络主机名)
# ------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# MongoDB 容器连接串
DB_URL=mongodb://mongodb:27017/EnglishMastery
MONGO_URL=mongodb://mongodb:27017/session

# Redis 容器连接串
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Session 加密密钥（生产环境请务必替换为高强度随机字符串）
SESSION_SECRET=enpromote_production_secret_key_change_me_in_prod

# ------------------------------------------
# 大语言模型与 AI 评测配置
# ------------------------------------------
# DeepSeek / OpenAI 兼容接口
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=your_deepseek_api_key_here

# 阿里云百炼 API Key (通义千问)
ALIYUN_API_KEY=your_dashscope_api_key_here

# Google Gemini API Key (用于 AVG 跑团与新多模态模块)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------
# 科大讯飞语音评测（流式版）配置
# ------------------------------------------
# 口语评测：设为 true 使用离线模拟假数据；false 或不填则调用讯飞真实 API
USE_MOCK_ISE=false
XUNFEI_APP_ID=your_xunfei_app_id
XUNFEI_API_KEY=your_xunfei_api_key
XUNFEI_API_SECRET=your_xunfei_api_secret

# ------------------------------------------
# 邮件验证码服务配置 (SMTP)
# ------------------------------------------
# 163 邮箱示例: host=smtp.163.com, port=465, secure=true
# QQ 邮箱示例:  host=smtp.qq.com,  port=465, secure=true
EMAIL_HOST=smtp.163.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@163.com
EMAIL_PASS=your_smtp_auth_code_here
